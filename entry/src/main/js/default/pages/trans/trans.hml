<div class="trans-container" onswipe="onSwipe">
    <text class="trans-title">文件传输</text>

    <div class="status-box">
        <text class="status-text">{{ statusText }}</text>
    </div>

    <list class="log-list">
        <list-item class="log-item" for="{{ messageLog }}">
            <text class="log-text">{{ $item }}</text>
        </list-item>
    </list>

    <text class="hint-text">保持本页在前台：发送 TXT 保存到书架，发送 Lite .bin 更新阅读背景（≤512×512）</text>

    <div class="back-btn-trans" onclick="goBack">
        <text class="back-btn-trans-text">返回书架</text>
    </div>

    <input type="button" class="reset-bg-btn" onclick="resetBackground" value="恢复默认背景" />
</div>
