<stack class="page-stack">
    <div class="container">
        <text class="main-title">阅读</text>

        <input type="button" class="menu-btn last-btn" onclick="openLastBook" value="{{ lastReadLabel }}" />

        <input type="button" class="menu-btn" onclick="goToBooks" value="书籍" />
        <input type="button" class="menu-btn" onclick="goToSetting" value="设置" />
        <input type="button" class="menu-btn" onclick="goToTransPage" value="传输书籍" />
    </div>
</stack>
