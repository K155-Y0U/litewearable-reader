<stack class="page-stack">
    <div class="container">
        <text class="app-title">阅读</text>

        <text class="last-card" onclick="openLastBook">{{ lastReadLabel }}</text>

        <text class="section-label">快捷操作</text>

        <div class="action-row">
            <input type="button" class="action-btn half" onclick="goToBooks" value="书籍" />
            <input type="button" class="action-btn half" onclick="goToSetting" value="设置" />
        </div>

        <input type="button" class="action-btn wide" onclick="goToTransPage" value="传输书籍" />
    </div>
</stack>
