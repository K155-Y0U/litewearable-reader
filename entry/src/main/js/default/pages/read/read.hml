<stack class="read-stack">
    <image class="read-bg" src="{{ backgroundImage }}" />

    <swiper
        class="swiper"
        loop="false"
        duration="200"
        vertical="true"
        onchange="onSwiperChange">
        <div class="page page-0">
            <text class="content">{{ page0 }}</text>
        </div>
        <div class="page page-1">
            <text class="content">{{ page1 }}</text>
        </div>
        <div class="page page-2">
            <text class="content">{{ page2 }}</text>
        </div>
    </swiper>

    <div class="back-area">
        <input type="button" class="back-btn" onclick="goBack" value="‹" />
    </div>
</stack>
