<div class="read-root">
    <div class="top-bar">
        <input type="button" class="back-btn" onclick="goBack" value="‹" />
    </div>

    <swiper
        class="swiper"
        loop="true"
        duration="200"
        vertical="true"
        onchange="onSwiperChange">
        <div class="page">
            <stack class="page-stack">
                <image class="page-bg" src="{{ backgroundImage }}" />
                <text class="content">{{ page0 }}</text>
            </stack>
        </div>
        <div class="page">
            <stack class="page-stack">
                <image class="page-bg" src="{{ backgroundImage }}" />
                <text class="content">{{ page1 }}</text>
            </stack>
        </div>
        <div class="page">
            <stack class="page-stack">
                <image class="page-bg" src="{{ backgroundImage }}" />
                <text class="content">{{ page2 }}</text>
            </stack>
        </div>
    </swiper>
</div>
