<div class="read-container">
    <swiper
        class="swiper"
        loop="false"
        duration="200"
        vertical="true"
        onchange="onSwiperChange">
        <div class="page">
            <text class="content">第 1 页\n这是文字</text>
        </div>
        <div class="page">
            <text class="content">第 2 页\n继续向上滑</text>
        </div>
        <div class="page">
            <text class="content">第 3 页\n再滑一次</text>
        </div>
    </swiper>

    <div class="back-area">
        <input type="button" class="back-btn" onclick="goBack" value="‹" />
    </div>
</div>
