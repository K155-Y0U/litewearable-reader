<div class="container" onswipe="touchMove">
    <swiper class="container-swiper" index="{{ sindex }} " vertical="true" loop="false" onchange="changeSwiper">
        <div class="container-col">
            <div class="text-container">
                <text>\n</text>
                <text class="text-content">{{inputWords}}_</text>
            </div>
            <div class="container-row">
                <input type="button" value="返回" class="func-button" onclick="cancelInput" />
                <input type="button" value="确定" class="func-button" onclick="finishInput" />
                <input type="button" value="退格" class="func-button" onclick="wordsBackspace" />
            </div>
            <text>上滑输入文字</text>
        </div>
        <div class="container-col">
            <input type="button" value="{{ letters }}" class="pinyin-button" onclick="jumpToCandidate" />
            <div class="container-row-candidate">
                <text  style="font-size: 30px; text-align: left; width: 200px;">{{words}}</text>
            </div>
            <div class="container-row">
                <input type="button" value="{{keyboardLetters[0]}}" class="input-button" onclick="input(0)" />
                <input type="button" value="{{keyboardLetters[1]}}" class="input-button" onclick="input(1)" />
                <input type="button" value="{{keyboardLetters[2]}}" class="input-button" onclick="input(2)" />
                <input type="button" value="{{keyboardLetters[3]}}" class="input-button" onclick="input(3)" />
                <input type="button" value="{{keyboardLetters[4]}}" class="input-button" onclick="input(4)" />
            </div>
            <div class="container-row" >
                <input type="button" value="{{keyboardLetters[10]}}" class="input-button" onclick="input(10)" />
                <input type="button" value="{{keyboardLetters[11]}}" class="input-button" onclick="input(11)" />
                <input type="button" value="{{keyboardLetters[12]}}" class="input-button" onclick="input(12)" />
                <input type="button" value="{{keyboardLetters[13]}}" class="input-button" onclick="input(13)" />
                <input type="button" value="{{keyboardLetters[14]}}" class="input-button" onclick="input(14)" />
            </div>
            <div class="container-row">
                <input type="button" value="{{keyboardLetters[19]}}" class="input-button" onclick="input(19)" />
                <input type="button" value="{{keyboardLetters[20]}}" class="input-button" onclick="input(20)" />
                <input type="button" value="{{keyboardLetters[21]}}" class="input-button" onclick="input(21)" />
                <input type="button" value="{{keyboardLetters[22]}}" class="input-button" onclick="input(22)" />
                <input type="button" value="←" class="input-button" onclick="backspace" />
            </div>
            <div class="container-row">
                <input type="button" value="中" class="input-button" onclick="changeToCn" />
                <input type="button" value="英" class="input-button" onclick="changeToEn" />
                <input type="button" value="符" class="input-button" onclick="changeToSymbol" />
            </div>
        </div>
        <div class="container-col">
            <input type="button" value="{{ letters }}" class="pinyin-button" onclick="jumpToCandidate" />
            <div class="container-row-candidate">
                <text style="font-size: 30px; text-align: left;width: 200px;">{{words}}</text>
            </div>
            <div class="container-row">
                <input type="button" value="{{keyboardLetters[5]}}" class="input-button" onclick="input(5)" />
                <input type="button" value="{{keyboardLetters[6]}}" class="input-button" onclick="input(6)" />
                <input type="button" value="{{keyboardLetters[7]}}" class="input-button" onclick="input(7)" />
                <input type="button" value="{{keyboardLetters[8]}}" class="input-button" onclick="input(8)" />
                <input type="button" value="{{keyboardLetters[9]}}" class="input-button" onclick="input(9)" />
            </div>
            <div class="container-row">
                <input type="button" value="{{keyboardLetters[14]}}" class="input-button" onclick="input(14)" />
                <input type="button" value="{{keyboardLetters[15]}}" class="input-button" onclick="input(15)" />
                <input type="button" value="{{keyboardLetters[16]}}" class="input-button" onclick="input(16)" />
                <input type="button" value="{{keyboardLetters[17]}}" class="input-button" onclick="input(17)" />
                <input type="button" value="{{keyboardLetters[18]}}" class="input-button" onclick="input(18)" />
            </div>
            <div class="container-row">
                <input type="button" value="{{keyboardLetters[22]}}" class="input-button" onclick="input(22)" />
                <input type="button" value="{{keyboardLetters[23]}}" class="input-button" onclick="input(23)" />
                <input type="button" value="{{keyboardLetters[24]}}" class="input-button" onclick="input(24)" />
                <input type="button" value="{{keyboardLetters[25]}}" class="input-button" onclick="input(25)" />
                <input type="button" value="←" class="input-button" onclick="backspace" />
            </div>
            <div class="container-row">
                <input type="button" value="中" class="input-button" onclick="changeToCn" />
                <input type="button" value="英" class="input-button" onclick="changeToEn" />
                <input type="button" value="符" class="input-button" onclick="changeToSymbol" />
            </div>
        </div>
    </swiper>
</div>
