<div class="container">
    <text class="title">Swiper 上下无缝</text>

    <text class="hint">上下滑动，看是否循环</text>

    <swiper class="swiper" loop="true" duration="200" vertical="true" onchange="onChange">
        <div class="page page-one">
            <text class="page-text">第 1 页</text>
        </div>
        <div class="page page-two">
            <text class="page-text">第 2 页</text>
        </div>
        <div class="page page-three">
            <text class="page-text">第 3 页</text>
        </div>
    </swiper>

    <text class="status">索引: {{ currentIndex }} / 切换: {{ changeCount }}</text>
    <input type="button" class="back" onclick="goBack" value="返回设置" />
</div>
